# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Canonical app URL for production auth redirects (Vercel → must match Supabase Redirect URLs)
# Example: https://your-app.vercel.app
# Local dev: leave unset — the app uses http://localhost:<port> automatically
# NEXT_PUBLIC_SITE_URL=

# Optional server-only (admin scripts — never expose to browser)
# SUPABASE_SECRET_KEY=