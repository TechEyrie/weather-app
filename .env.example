# Optional — the app builds and runs without Supabase (guest mode).
# For auth sync on Vercel: Project → Settings → Environment Variables
# Add both for Production (and Preview if needed), then redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: silence Next.js build telemetry line on Vercel
# NEXT_TELEMETRY_DISABLED=1